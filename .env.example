# CONFIGURAÇÃO DE INTELIGÊNCIA ARTIFICIAL (OpenAI-Compatible Free Providers)
# Esta aplicação NÃO utiliza Google Gemini ou qualquer serviço pago do Google.
# Ela utiliza provedores gratuitos ou open-source compatíveis com a API do OpenAI (ex: OpenRouter, Groq).

# Chave de API do Provedor de LLM.
# Para OpenRouter, obtenha uma chave gratuita em: https://openrouter.ai/
# Para Groq, obtenha uma chave gratuita em: https://console.groq.com/
LLM_API_KEY="SUA_CHAVE_DE_API_AQUI"

# URL Base do Provedor de LLM.
# Para OpenRouter: https://openrouter.ai/api/v1
# Para Groq: https://api.groq.com/openai/v1
LLM_BASE_URL="https://openrouter.ai/api/v1"

# Modelo de Linguagem a ser utilizado.
# Para OpenRouter (modelos totalmente gratuitos):
# - meta-llama/llama-3-8b-instruct:free
# - qwen/qwen-2.5-7b-instruct:free
# - google/gemma-2-9b-it:free
# Para Groq (modelos rápidos e gratuitos):
# - llama-3.1-8b-instant
# - llama3-8b-8192
LLM_MODEL="meta-llama/llama-3-8b-instruct:free"

# APP_URL: Injetado automaticamente no Cloud Run.
APP_URL="http://localhost:3000"
